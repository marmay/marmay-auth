    "websiteUrl": "https://@APEX@",
    "privacyUrl": "https://@APEX@",
    "termsOfUseUrl": "https://@APEX@"
  },
  "name": {
    "short": "BG Horn",
    "full": "BG Horn Schulanwendungen"
  },
  "description": {
    "short": "Interne Anwendungen des BG Horn als Registerkarten",
    "full": "Bindet die internen Anwendungen des BG Horn (Kompetenzraster der Klassen, Website-Redaktion) als Registerkarten in Teams ein. Beim Hinzufügen einer Registerkarte wird die gewünschte Anwendung ausgewählt; die Anmeldung erfolgt automatisch über das Schulkonto."
  },
  "icons": {
    "color": "color.png",
    "outline": "outline.png"
  },
  "accentColor": "#0284C7",
  "configurableTabs": [
    {
      "configurationUrl": "https://auth.@APEX@/teams/config",
      "scopes": ["team"],
      "canUpdateConfiguration": true
    }
  ],
  "permissions": ["identity"],
  "validDomains": ["@APEX@", "*.@APEX@"],
  "webApplicationInfo": {
    "id": "@CLIENT_ID@",
    "resource": "api://auth.@APEX@/@CLIENT_ID@"
  }
}
